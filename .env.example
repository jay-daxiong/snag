# ============================================================
# Snag 上线环境变量模板（复制为 .env 或直接注入环境变量）
# 全部「可选」：缺省时自动降级为演示模式，接口形状不变，方便本地开发。
# 上架前请把真实密钥填入并启用 HTTPS。
# ============================================================

# ---- 服务端口 ----
PORT=8787

# ---- 持久化（可选，推荐）----
# 设置后启用 Postgres 真·持久化（数据跨重启/部署保留）；留空则仅本地 JSON 文件。
# 免费档可用 Supabase / Neon 的连接串，例如：
# postgresql://user:pass@host:5432/postgres?sslmode=require
DATABASE_URL=

# ---- 后台账号（务必修改！默认 admin/admin123 仅用于演示）----
SNAG_ADMIN_USER=admin
SNAG_ADMIN_PASS=改一个强密码
# 可选：审核员账号（只能做内容/实名/举报审核，看不到用户与数据面板）
SNAG_MOD_USER=
SNAG_MOD_PASS=

# ---- HTTPS（有证书即自动启用，否则回退 HTTP）----
# Let's Encrypt 证书路径示例：/etc/letsencrypt/live/你的域名/fullchain.pem
#                        私钥：/etc/letsencrypt/live/你的域名/privkey.pem
SNAG_TLS_CRT=
SNAG_TLS_KEY=
SNAG_TLS_CA=

# ---- 短信（阿里云默认；SNAG_SMS_PROVIDER=tencent 切腾讯云）----
SNAG_SMS_PROVIDER=aliyun
SNAG_SMS_ALIYUN_KEY=
SNAG_SMS_ALIYUN_SECRET=
SNAG_SMS_ALIYUN_SIGN=           # 短信签名，如「Snag」
SNAG_SMS_ALIYUN_TEMPLATE=       # 验证码模板 CODE，如 SMS_123456789
# 腾讯云短信（provider=tencent 时生效）
SNAG_SMS_TENCENT_SECRET_ID=
SNAG_SMS_TENCENT_SECRET_KEY=
SNAG_SMS_TENCENT_APPID=
SNAG_SMS_TENCENT_SIGN=
SNAG_SMS_TENCENT_TEMPLATE=

# ---- 支付（微信支付 V3 / 支付宝）----
# 微信支付 V3（配齐以下 6 项才走真实下单 + /notify 验签；缺任一项走演示二维码）
SNAG_WX_MCH_ID=                  # 商户号
SNAG_WX_APP_ID=                  # 公众号/小程序 AppID
SNAG_WX_APIV3_KEY=               # APIv3 密钥，用于回调报文解密
SNAG_WX_SERIAL=                  # 商户 API 证书序列号
SNAG_WX_PRIVATE_KEY=             # 商户 API 私钥（apiclient_key.pem 内容或路径）
SNAG_WX_PLATFORM_PUBLIC_KEY=     # 微信平台证书公钥 PEM（/notify 验签必需）
SNAG_WX_NOTIFY_URL=              # 支付回调地址，如 https://your.domain/api/pay/notify
# 支付宝（配齐 APP_ID + 私钥 + 公钥 走真实下单）
SNAG_ALI_APP_ID=
SNAG_ALI_PRIVATE_KEY=
SNAG_ALI_PUBLIC_KEY=             # 支付宝公钥
SNAG_ALI_NOTIFY_URL=             # 支付回调地址（可选）

# ---- 实名认证（第三方实人认证，如阿里云实人认证）----
SNAG_KYC_PROVIDER=
SNAG_KYC_KEY=
SNAG_KYC_SECRET=

# ---- AI 智能客服（OpenAI 兼容接口）----
# 默认指向本地 OFM 免费网关；上线可换成任意 OpenAI 兼容服务
SNAG_LLM_BASE=http://127.0.0.1:18900/v1
SNAG_LLM_KEY=free
SNAG_LLM_MODEL=gpt-3.5-turbo

# ---- 内容机审（可选接入阿里云/腾讯云内容安全 API）----
SNAG_MOD_API=
SNAG_MOD_KEY=
